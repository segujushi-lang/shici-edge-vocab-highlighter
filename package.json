{
  "name": "shici-edge-vocab-highlighter",
  "version": "1.6.0",
  "description": "支持分类颜色、批量导入和多来源中文释义的 Microsoft Edge 生词高亮扩展",
  "author": "segujushi-lang",
  "license": "MIT",
  "keywords": [
    "edge-extension",
    "browser-extension",
    "vocabulary",
    "translation",
    "manifest-v3"
  ],
  "files": [
    "manifest.json",
    "background.js",
    "content.js",
    "content.css",
    "popup.html",
    "popup.css",
    "popup.js",
    "shared.js",
    "PRIVACY.md",
    "proxy/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/segujushi-lang/shici-edge-vocab-highlighter.git"
  },
  "bugs": {
    "url": "https://github.com/segujushi-lang/shici-edge-vocab-highlighter/issues"
  },
  "homepage": "https://github.com/segujushi-lang/shici-edge-vocab-highlighter#readme",
  "scripts": {
    "check": "node --check shared.js && node --check background.js && node --check content.js && node --check popup.js && node --check proxy/worker.mjs && node --check proxy/server.mjs",
    "test": "node --test --test-isolation=none tests/shared.test.js tests/manifest.test.js tests/background.test.js tests/google-proxy.test.js",
    "proxy:start": "node proxy/server.mjs",
    "test:serve": "node tests/serve-fixture.js"
  }
}
